poc_web/api/runs/
config/local.yaml
config/propfirms.user.yaml
config/symbols.user.yaml

# Entorno y caches (poc_web/web/dist/ SI se versiona: es el front compilado)
node_modules/
__pycache__/
.pytest_cache/
.venv/
.DS_Store
